{"desc":"Navigation","groups":[{"children":[{"children":[{"defaultValue":0.5,"desc":"If manual_block is turned off, the maximum manual control speed and navigation speed will be limited to 0.3 m/s.","key":"maxSpeed","maxValue":5,"minValue":0.001,"name":"Maximum Speed","type":"double","unit":"m/s","value":1},{"defaultValue":0.3,"desc":"Maximum reverse speed.","key":"maxBackSpeed","maxValue":5,"minValue":0.001,"name":"Maximum Reverse Speed","type":"double","unit":"m/s","value":0.5},{"defaultValue":0.5,"desc":"Maximum acceleration.","key":"maxAcc","maxValue":5,"minValue":0.001,"name":"Maximum Acceleration","type":"double","unit":"m/s^2","value":0.5},{"defaultValue":0.15,"desc":"Maximum deceleration.","key":"maxDec","maxValue":5,"minValue":0.001,"name":"Maximum Deceleration","type":"double","unit":"m/s^2","value":0.15},{"defaultValue":60,"desc":"If manual_block is turned off, the maximum manual control rotate speed and unload navigation rotate speed will be limited to 30 deg/s.","key":"maxRot","maxValue":360,"minValue":0.001,"name":"Maximum Rotation Speed","type":"double","unit":"deg/s","value":60},{"defaultValue":30,"desc":"Maximum rotation acceleration.","key":"maxRotAcc","maxValue":360,"minValue":0.001,"name":"Maximum Rotation Acceleration","type":"double","unit":"deg/s^2","value":30},{"defaultValue":30,"desc":"Maximum rotation deceleration.","key":"maxRotDec","maxValue":360,"minValue":0.001,"name":"Maximum Rotation Deceleration","type":"double","unit":"deg/s^2","value":30}],"defaultValue":0,"desc":"Unload status parameters.","key":"unload","name":"Unload Status Parameters","type":"array","value":0},{"children":[{"defaultValue":0.5,"desc":"Load maximum speed.","key":"loadMaxSpeed","maxValue":5,"minValue":0.001,"name":"Load Maximum Speed","type":"double","unit":"m/s","value":0.5},{"defaultValue":0.3,"desc":"Load maximum reverse speed.","key":"loadMaxBackSpeed","maxValue":5,"minValue":0.001,"name":"Load Maximum Reverse Speed","type":"double","unit":"m/s","value":0.3},{