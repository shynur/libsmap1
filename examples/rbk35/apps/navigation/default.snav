ing Method","type":"comboBox","value":"mpc"}],"desc":"Motion control.","key":"motionControl","name":"Motion Control","type":"array"},{"children":[{"bindType":"device:Laser multiple; device:Camera multiple; device:DISensor multiple; device:DistanceSensor multiple","defaultValue":"","desc":"Detection device","key":"detectionDevice","name":"Detection Device","type":"bindType","value":"Laser-000,Laser-001,Laser-002,Camera-001"},{"defaultValue":2,"desc":"Laser collision points threshold number.","key":"collisionPointNum","maxValue":1000,"minValue":1,"name":"Laser Collision Point Number","type":"int","value":2},{"defaultValue":1,"desc":"Depth camera collision points threshold number.","key":"collisionPointNumCamera","maxValue":1000,"minValue":1,"name":"Collision Point Number Camera","type":"int","value":1},{"defaultValue":true,"desc":"Whether the navigation uses a virtual laser to detect obstacles.","key":"virtualLaser","name":"Virtual Laser","type":"bool","unit":"","value":true},{"children":[{"bindType":"device:Laser multiple;device:Camera multiple;device:DistanceSensor multiple;device:DISensor multiple","defaultValue":"","desc":"Collision device.","key":"collisionDevice","name":"Collision Device","type":"bindType","value":""},{"bindType":"shape:rectangle multiple no-rotate;background-item:chassis","defaultValue":"","desc":"Additional robot collision area.","key":"collisionShape","name":"Collision Shape","type":"bindType","value":""}],"defaultValue":"","desc":"Collision model.","isClone":true,"key":"collisionModel","name":"Collision Model","type":"array","value":""},{"children":[{"bindType":"device:Laser multiple;device:Camera multiple;device:DistanceSensor multiple;device:DISensor multiple","defaultValue":"","desc":"Deduct device.","key":"deductDevice","name":"Deduct Device","type":"bindType","value":""},{"bindType":"shape:rectangle multiple;background-item:chassis","defaultValue":"","desc":"Deduct shape.","key":"deductShape","name":"Deduct Shape","type":"bindType","value":""},{"defaultValue":true,"desc":"The laser deduction area ignores the z axis.","key":"ignoreZ","name":"Ignore Z","type":"bool","unit":"","value":true},{"defaultValue":0,"desc":"Laser deduction area z maximum value.","key":"zMax","maxValue":100,"minValue":-100,"name":"Z Maximum","type":"double","unit":"m","value":0},{"defaultValue":0,"desc":"Laser deduction area z minimum value.","key":"zMin","maxValue":100,"minValue":-100,"name":"Z Minimum","type":"double","unit":"m","value":0}],"desc":"Deduct model.","isClone":true,"key":"deductModel","name":"Deduct Model","type":"array"},{"children":[{"bindType":"shape:rectangle multiple;background-item:chassis","defaultValue":"","desc":"Region shape.","key":"shape","name":"Shape","type":"bindType","value":""},{"bindType":"device:DO","defaultValue":"","desc":"DO device.","key":"do","name":"DO","type":"bindType","value":""},{"defaultValue":0,"desc":"The number of times the laser point continuously detects the presence in the DO area.","key":"filterNum","maxValue":1000,"minValue":0,"name":"Filter Number","type":"int","unit":"","value":0}],"defaultValue":"","desc":"DO region.","isClone":true,"key":"doRegion","name":"DO Region","type":"array","value":""},{"children":[{"desc":"Disable 3D point cloud hole detection","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":-0.05,"desc":"Below this height is considered a hole","key":"holeDepth","maxValue":0.05,"minValue":-0.5,"name":"Hole Depth","type":"double","unit":"m","value":-0.05}],"desc":"Enable 3D point cloud hole detection","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Whether Enable 3D Point Cloud Hole Detection","key":"3DPointHoleDetection","name":"3D Point Cloud Hole Detection","type":"comboBoxBool","value":"off"},{"defaultValue":0.05,"desc":"Obstacle detection height, obstacles will only be recognized as obstacles if their distance from the ground exceeds this threshold","key":"groundHeight","maxValue":0.5,"minValue":0.01,"name":"Ground Height","type":"double","unit":"m","value":0.1},{"defaultValue":1,"desc":"When an obstacle is detected by the 3D sensor at a spatially consistent position in consecutive frames, it is judged as a valid obstacle","key":"3DPointFilterFrameNum","maxValue":10,"minValue":0,"name":"3D Point Cloud Filter Frame Number","permission":1,"type":"int","unit":"","value":1},{"defaultValue":0.05,"desc":"3D point cloud resolution (m)","key":"3DPointCloudFilterRadius","maxValue":0.1,"minValue":0.01,"name":"3D Point Cloud Filter Radius","permission":1,"type":"double","unit":"m","value":0.05},{"defaultValue":0.05,"desc":"Laser Filter Radius (m)","key":"2DLaserFilterRadius","maxValue":1,"minValue":0,"name":"2D Laser Filter Radius","permission":1,"type":"double","unit":"m","value":0.05},{"defaultValue":2,"desc":"The laser radius filtering algorithm draws a circle with a point as the center. If the number of points within the circle does not reach the threshold set by the parameter, the point will be filtered out. In actual environments, noise is often isolated points. By setting this parameter appropriately (usually increasing the value), noise can be effectively filtered out","key":"2DLaserFilterMinNeighbor","maxValue":100,"minValue":0,"name":"Laser Filter Minimum Neighbor","permission":1,"type":"int","unit":"","value":2},{"defaultValue":false,"desc":"Whether enable depth camera for detection for obstacle","key":"depthCameraForkDetection","name":"Depth Camera Fork Detection","type":"bool","value":false},{"children":[{"desc":"Disable 3D point cloud hole Filter","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":0.2,"desc":"The filter radius of hole","key":"holeFilterRadius","maxValue":10,"minValue":0,"name":"Hole Filter Radius","type":"double","unit":"m","value":0.2},{"defaultValue":3,"desc":"Points number below this value will be discard","key":"holePointNum","maxValue":100,"minValue":0,"name":"Hole Filter Threshold","type":"int","value":3}],"desc":"Enable 3D point cloud hole Filter","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Whether Enable 3D Point Cloud Hole Filter","key":"3DPointHoleFilter","name":"3D Point Cloud Hole Filter","type":"comboBoxBool","value":"off"}],"defaultValue":0,"desc":"Collision detection","key":"collisionDetection","name":"Collision Detection","type":"array","value":0},{"children":[{"defaultValue":0,"desc":"Emergency stop distance.","key":"emergencyStopDist","maxValue":10,"minValue":0,"name":"Emergency Stop Distance","type":"double","unit":"m","value":0},{"defaultValue":0.5,"desc":"Emergency time.","key":"emergencyTime","maxValue":10,"minValue":0.001,"name":"Emergency Time","type":"double","unit":"s","value":0.5},{"defaultValue":0.2,"desc":"Decelerate to the speed of encountering obstacles.","key":"obsDecSpeed","maxValue":2,"minValue":0,"name":"Obstacle Deceleration Speed","type":"double","unit":"m/s","value":0.2},{"children":[{"desc":"Block to alarm Unable.","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":2,"desc":"Alarm will start after being blocked.","key":"blockToAlarmTime","maxValue":6000,"minValue":0,"name":"Block To Alarm Time","type":"double","unit":"s","value":2},{"defaultValue":1.5,"desc":"Extra stay time after the end of the block.","key":"blockToMoveTime","maxValue":10,"minValue":0,"name":"Block To Move Time","type":"double","unit":"s","value":1.5}],"desc":"Block to alarm Enable.","key":"on","name":"True","type":"array"}],"defaultValue":"on","desc":"Whether to alarm after being blocked.","key":"blockToAlarm","name":"Block To Alarm","type":"comboBoxBool","unit":"","value":"on"},{"defaultValue":1.2,"desc":"Prediction simulation time.","key":"simTime","maxValue":10,"minValue":0,"name":"Prediction Simulation Time","type":"double","unit":"s","value":1.2},{"defaultValue":0.2,"desc":"Prediction simulation time step.","key":"simDt","maxValue":10,"minValue":0,"name":"Prediction Simulation Time Step","type":"double","unit":"s","value":0.2},{"