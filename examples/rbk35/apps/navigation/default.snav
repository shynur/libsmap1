":[{"desc":"Tip proof unable.","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":-1,"desc":"When the height of the forklift is greater than safeHeight, the maximum speed of the forklift will be limited to safeSpeed.","key":"safeHeight","maxValue":100,"minValue":-1,"name":"Safe Height","type":"double","unit":"m","value":-1},{"defaultValue":-1,"desc":"Safe driving speed.","key":"safeSpeed","maxValue":100,"minValue":-1,"name":"Safe Speed","type":"double","unit":"m/s","value":-1}],"desc":"Tip proof Enable.","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Whether enable forklift height safety check.","key":"enableForkliftHeightSafetyCheck","name":"Enable Forklift Height Safety Check","type":"comboBoxBool","unit":"","value":"off"},{"children":[{"desc":"Tip proof unable.","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":180,"desc":"Roll maximum threshold, if the roll of a single IMU exceeds the threshold, it will report a tilt anomaly.","key":"rollAngleMaxThres","maxValue":180,"minValue":-1,"name":"Roll Angle Max Threshold","type":"double","unit":"deg","value":180},{"defaultValue":90,"desc":"Pitch maximum threshold, if the piych of a single IMU exceeds the threshold, it will report a tilt anomaly.","key":"pitchAngleMaxThres","maxValue":180,"minValue":-1,"name":"Pitch Angle Max Threshold","type":"double","unit":"deg","value":90}],"desc":"Tip proof Enable.","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Avoid falling down.","key":"avoidFallingDown","name":"Avoid Falling Down","type":"comboBoxBool","unit":"","value":"off"}],"defaultValue":0,"desc":"Safe check.","key":"safeCheck","name":"Safe Check","type":"array","value":0},{"children":[{"desc":"Local free bypass unable.","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":4,"desc":"Global default path width, 0 means not considering path width.","key":"pathWidth","maxValue":10,"minValue":0.1,"name":"Path Width","type":"double","unit":"m","value":8},{"defaultValue":true,"desc":"Should the escape logic be enabled when the detour path planning fails.","key":"recoveryEnable","name":"Recovery Enable","type":"bool","unit":"","value":true},{"children":[{"desc":"Line free navigation unable.","key":"off","name":"False","type":"string"},{"children":[{"defaultValue":1,"desc":"Generate a front point at the preAPDist distance in front of the current point direction. Effective when going to AP point and leaving AP point, will go to the front point first.","key":"preAPDist","maxValue":5,"minValue":-5,"name":"AP Point Front Distance","type":"double","unit":"m","value":1},{"defaultValue":0,"desc":"Front point angle. Only effective when going to AP point, not effective when leaving.","key":"preAPAngle","maxValue":180,"minValue":-180,"name":"AP Point Front Angle","type":"double","unit":"deg","value":0},{"defaultValue":0.5,"desc":"Maximum navigation speed on the path between front point and target point. Only effective when going to AP point, not effective when leaving.","key":"preAPMaxSpeed","maxValue":1,"minValue":0,"name":"AP Point Front Max Speed","type":"double","unit":"m/s","value":0.5},{"defaultValue":true,"desc":"Whether to go backward from front point to target point. Only effective when going to AP point, not effective when leaving.","key":"apBackward","name":"AP Backward","type":"bool","value":true},{"defaultValue":-1,"desc":"Generate a front point at the preCPDist distance in front of the current point direction. Effective when going to CP point and leaving CP point, will go to the front point first.","key":"preCPDist","maxValue":5,"minValue":-5,"name":"CP Point Front Distance","type":"double","unit":"m","value":-1},{"defaultValue":false,"desc":"Whether to go backward from front point to target point. Only effective when going to CP point, not effective when leaving.","key":"cpBackward","name":"CP Backward","type":"bool","value":false},{"defaultValue":0.6,"desc":"Grid map resolution.","key":"gridMapResolution","maxValue":10,"minValue":0.1,"name":"Grid Map Resolution","type":"double","value":0.6},{"defaultValue":1.2,"desc":"Grid map load resolution.","key":"gridMapLoadResolution","maxValue":10,"minValue":0.1,"name":"Grid Map Load Resolution","type":"double","value":1.2}],"desc":"Line free navigation enable.","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Line free navigation.","key":"lineFreeNav","name":"Line Free Navigation","type":"comboBoxBool","value":"off"},{"children":[{"children":[{"defaultValue":0.1,"desc":"Away Obstacle Distance.","key":"awayObsDist","maxValue":2,"minValue":0,"name":"Away Obstacle Distance","type":"double","value":0.1}],"desc":"Precision first.","key":"precisionFirst","name":"Precision First","type":"array"},{"children":[{"defaultValue":true,"desc":"Enable to always replan the local path even if the previous path remains valid, ensuring more up-to-date paths.","key":"fgAlawaysReplan","name":"Always Replan Local Path","type":"bool","value":true},{"defaultValue":false,"desc":"Automatically adjust obstacle inflation based on the robot's current speed for safer navigation.","key":"dwaDynInflate","name":"Tuning Inflate By Speed","type":"bool","value":false},{"defaultValue":false,"desc":"Enable speed limiting near obstacles or during sharp turns to improve safety and stability.","key":"dwaSpeedLimit","name":"Slow Down When Near Obstacles Or Curve Path","type":"bool","value":false},{"defaultValue":0.02,"desc":"Set the scaling factor for obstacle cost in DWA, influencing how strongly the planner avoids obstacles.","key":"dwaObs","maxValue":10,"minValue":0.01,"name":"Obstacle Repulsive Force Coefficient","type":"double","value":0.02},{"defaultValue":64,"desc":"Set the scaling factor for path cost in DWA, controlling how much the planner prefers staying close to the reference path.","key":"dwaPath","maxValue":100,"minValue":1,"name":"Path Attractive Force Coefficient","type":"double","value":64},{"defaultValue":64,"desc":"Set the scaling factor for goal cost in DWA, controlling how strongly the planner is attracted to the goal point.","key":"dwaGoal","maxValue":100,"minValue":1,"name":"Goal Attractive Force Coefficient","type":"double","value":64},{"defaultValue":0.1,"desc":"Set the look-ahead distance on the path for DWA to evaluate upcoming obstacles and path alignment.","key":"dwaAheadDist","maxValue":2,"minValue":0.1,"name":"Look Ahead Dist On Path","type":"double","value":0.1},{"defaultValue":3,"desc":"Set the weight of the linear component in DWA path scoring, influencing directness versus smoothness.","key":"dwaPathLinearWeight","maxValue":10,"minValue":0,"name":"Path Score Position Weight","type":"double","value":3},{"defaultValue":5,"desc":"Set the weight of the alignment component in DWA path scoring, influencing how well the robot aligns with the path.","key":"dwaPathAlignWeight","maxValue":10,"minValue":0,"name":"Path Score Angle Weight","type":"double","value":5},{"defaultValue":0.8,"desc":"Set the forward simulation time for each DWA trajectory evaluation.","key":"dwaSimTime","maxValue":2,"minValue":0.1,"name":"Predict Collision Time","type":"double","unit":"s","value":0.8},{"defaultValue":false,"desc":"Enable automatic search for a nearby backup goal if the main navigation goal is blocked by obstacles.","key":"dwaBackupGoal","name":"Find Backup Goal When Navigation Goal Is Blocked","type":"bool","value":false}],"desc":"Flexibility first.","key":"flexibilityFirst","name":"Flexibility First","type":"array"},{"desc":"Safety first.","key":"safetyFirst","name":"Safety First","type":"array"}],"defaultValue":"precisionFirst","desc":"Tracking method.","key":"trackingMethod","name":"Tracking Method","type":"comboBox","value":"precisionFirst"},{"children":[{"desc":"OFF.","key":"off","name":"OFF","type":"array"},{"desc":"WIFI.","key":"wifi","name":"WIFI","type":"array"},{"desc":"ESP.","key":"esp","name":"ESP","type":"array"},{"desc":"M4.","key":"m4","name":"M4","type":"array"}],"defaultValue":"off","desc":"Distribution mode for multi robot navigation.","key":"distributedMode","name":"Distribution Mode For Multi Robot Navigation","type":"comboBox","value":"off"},{"children":[{"defaultValue":0.05,"desc":"Set the inflation radius in meters. Obstacles will be expanded by this radius to keep a safe distance during planning.","key":"lmInflate","maxValue":5,"minValue":0,"name":"Inflation Radius","type":"double","unit":"m","value":0.05},{"defaultValue":true,"desc":"Enable or disable printing the local map for debugging and analysis.","key":"lmPrint","name":"Print For Debug","type":"bool","value":true},{"defaultValue":0.02,"desc":"Set the lethal obstacle radius in meters. Obstacles within this radius are treated as impassable.","key":"lmLethal","maxValue":2,"minValue":0,"name":"Lethal Radius","type":"double","unit":"m","value":0.02},{"defaultValue":0,"desc":"Set the foot length for additional inflation.","key":"lmAvoidFootDistance","maxValue":0.5,"minValue":0,"name":"Avoid Foot Distance","type":"double","unit":"m","value":0},{"defaultValue":50,"desc":"Define the cost factor for the Theta* pathfinding algorithm used in free navigation mode.","key":"fgThetaStarCost","maxValue":252,"minValue":10,"name":"Theta Star Search Cost","type":"int","value":50}],"desc":"Costmap parameters.","key":"costmap","name":"Costmap","type":"array"}],"desc":"Local free bypass enable.","key":"on","name":"True","type":"array"}],"defaultValue":"off","desc":"Free bypass.","key":"freeBypass","name":"Free Bypass","type":"comboBoxBool","value":"on"},{"children":[{"defaultValue":0.04,"desc":"The error threshold for the deviation between the shelf and the center of mileage during the follow-up start.","key":"spinDs","maxValue":1,"minValue":0,"name":"Spin Deviation Threshold","type":"double","unit":"m","value":0.04},{"defaultValue":0.1,"desc":"The difference between the robot tray angle and the tray target angle in the following state before path navigation. If the difference is greater than this threshold, the robot needs to first rotate the tray into place.","key":"spinGoTheta","maxValue":360,"minValue":0.01,"name":"Spin Go Theta","type":"double","unit":"deg","value":0.1},{"defaultValue":false,"desc":"When this parameter is true, the orientation of the goods is determined by the goods QR code or task instructions. When this parameter is false, the orientation of the goods is consistent with the odometer.","key":"adjustGoodsDir","name":"Adjust Goods Direction","type":"bool","unit":"","value":false},{"defaultValue":0,"desc":"Follow-up reference angular velocity threshold.","key":"spinRefThreshold","maxValue":360,"minValue":0,"name":"Spin Reference Threshold","type":"double","unit":"","value":0},{"defaultValue":false,"desc":"Whether to follow in the non-lifting state.","key":"unloadSpin","name":"Unload Spin","type":"bool","unit":"","value":false}],"defaultValue":0,"desc":"Spin follow.","key":"spinFollow","name":"Spin Follow","type":"array","value":0},{"children":[{"defaultValue":0.2,"desc":"W Kp value of line patrol PID in magnetic navigation.","key":"magKp","maxValue":1000000,"minValue":0,"name":"Magnetic Kp","type":"double","value":0.2},{"defaultValue":0.1,"desc":"W Kd value of line patrol PID in magnetic navigation.","key":"magKd","maxValue":1000000,"minValue":0,"name":"Magnetic Kd","type":"double","value":0.1}],"defaultValue":0,"desc":"Magnetic.","key":"magnetic","name":"Magnetic","type":"array","value":0},{"children":[{"defaultValue":1,"desc":"Following car's ki.","key":"followKi","maxValue":1000000,"minValue":0,"name":"Following Car's Ki","type":"double","value":1},{"defaultValue":1,"desc":"Following car's kp.","key":"followKp","maxValue":1000000,"minValue":0,"name":"Following Car's Kp","type":"double","value":1},{"defaultValue":0.1,"desc":"Multiple robots adjust kp.","key":"multiRobotsAdjustKp","maxValue":10000,"minValue":0,"name":"Multiple Robots Adjust Kp","type":"double","value":0.1},{"bindType":"device:Laser","defaultValue":"","desc":"Use which laser to keep two robot distance.","key":"multiRobotsLaserName","name":"Use Which Laser To Keep Two Robot Distance","type":"bindType","value":""},{"defaultValue":1,"desc":"vKp value of omnidirectional vehicle PID.","key":"multiRobotsvKp","maxValue":100,"minValue":0,"name":"Multiple Robots vKp","type":"double","value":1},{"defaultValue":0.1,"desc":"vKd value of omnidirectional vehicle PID.","key":"multiRobotsvKd","maxValue":100,"minValue":0,"name":"Multiple Robots vKd","type":"double","value":0.1},{"defaultValue":1,"desc":"WKp value of omnidirectional vehicle PID.","key":"multiRobotswKp","maxValue":100,"minValue":0,"name":"Multiple Robots wKp","type":"double","value":1},{"defaultValue":0.1,"desc":"wKd value of omnidirectional vehicle PID.","key":"multiRobotswKd","maxValue":100,"minValue":0,"name":"Multiple Robots wKd","type":"double","value":0.1}],"defaultValue":0,"desc":"Multiple robots.","key":"multiRobots","name":"Multiple Robots","type":"array","value":0}]}