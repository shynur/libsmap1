{"desc":"blockMap","groups":[{"children":[{"children":[{"bindType":"device:Laser multiple","defaultValue":"","desc":"The device use for 2D localization, Only supports 2D Laser or multi-line Laser's horizontal lines, Does not support solid state radar","key":"localizationLaser","name":"Localization Laser","type":"bindType","unit":"","value":"Laser-000"},{"children":[{"desc":"Feature localization unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":30,"desc":"Maximum valid features range threshold, it may cause the calculation to be too slow if too large.","key":"featuresValidRange","maxValue":200,"minValue":0.1,"name":"Features Valid Range","type":"double","unit":"m","value":30},{"decimals":3,"defaultValue":10,"desc":"Maximum valid features localization rotate threshold, it may cause incorrect positioning if too large.","key":"featuresLocRotateThd","maxValue":180,"minValue":0,"name":"Features Localization Rotate Threshold","type":"double","unit":"deg","value":10}],"desc":"Feature localization enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"Feature localization can offer an additional auxiliary positioning approach in scenarios where localization are easy to lose.","key":"featureLocEnable","name":"Feature Localization","type":"comboBoxBool","value":"off"},{"children":[{"desc":"Feature localization unable","key":"off","name":"OFF","type":"string"},{"key":"on","name":"ON"}],"defaultValue":"off","desc":"Map Update can improve positioning stability ","key":"mapUpdateEnable","name":"Map Update","type":"comboBoxBool","value":"off"},{"children":[{"desc":"RTK localization unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":0.05,"desc":"RTK Localization Weight in fusion positioning, too large may reduce the smoothness of the trajectory.","key":"theRTKWeight","maxValue":1,"minValue":0,"name":"RTK Localization Weight","type":"double","unit":"","value":0.05}],"desc":"RTK localization enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"RTK localization can offer an additional auxiliary positioning approach in scenarios where localization are easy to lose.","key":"useRTKLocalization","name":"RTK Localization","type":"comboBoxBool","value":"off"},{"children":[{"desc":"stop confidence unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":0.4,"desc":"The threshold at which the error is reported if robot confidence is less than this value","key":"stopConfidenceThd","maxValue":1,"minValue":0,"name":"Stop Confidence Threshold","type":"double","unit":"","value":0.4}],"desc":"stop confidence enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"Stop Confidence Enable, if enabled, stop will be triggered when the robot confidence is less than the threshold.","key":"stopConfidenceTigger","name":"stop confidence enable","type":"comboBoxBool","value":"off"},{"defaultValue":true,"desc":"Whether to use particle filter optimization, when the activation conditions are met, the stability of the positioning can be enhanced.","key":"usePFOptimize","name":"Use PF Optimize","type":"bool","unit":"","value":true},{"decimals":3,"defaultValue":0.2,"desc":"The size of the map grid for auto relocation, the larger the grid size, the faster the repositioning speed, which consequently leads to a decrease in accuracy.","key":"autoRelocGirdSize","maxValue":5,"minValue":0.1,"name":"Auto Reloc Gird Size","type":"double","unit":"m","value":0.2},{"defaultValue":false,"desc":"Use SLAM 2D for localization, it can be used to detect skidding conditions, and correct skidding with Skid Correction","key":"useSLAM2D","name":"Use SLAM 2D","type":"bool","unit":"","value":false},{"children":[{"desc":"Skid correction unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":0.7,"desc":"If the confidence level is less than this value, the robot will correct its position when it detects skidding","key":"skidCorrectionThd","maxValue":1,"minValue":0,"name":"Skid Correction Threshold","type":"double","unit":"","value":0.7}],"desc":"Skid correction enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"Skid Correction Enable, if enabled, warns when the robot detects skidding.","key":"skidCorrection","name":"Skid Correction","type":"comboBoxBool","value":"off"}],"desc":"2D Localization Setting","key":"laser2d","name":"2D Laser Localization","type":"array"},{"children":[{"bindType":"device:Laser multiple","defaultValue":"","desc":"The device use for reflector localization, Only 2D laser is supported","key":"localizationLaser","name":"Localization Laser","type":"bindType","unit":"","value":""},{"children":[{"desc":"detect with mean fitting unable","key":"off","name":"OFF","type":"string"},{"desc":"detect with mean fitting able","key":"on","name":"ON","type":"string"}],"defaultValue":"on","desc":"Fit the mean value of the reflective column center","key":"refDetectType","name":"Reflector detect with mean fitting","type":"comboBoxBool","value":"on"},{"defaultValue":150,"desc":"The laser intensity threshold of detecting reflector (0~255)","key":"refRSSI","maxValue":255,"minValue":0,"name":"Reflector Intensity Threshold","type":"int","unit":"","value":150},{"children":[{"desc":"stop confidence unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":0.9,"desc":"The threshold at which the error is reported if robot confidence is less than this value","key":"stopConfidenceThd","maxValue":1,"minValue":0,"name":"Stop Confidence Threshold","type":"double","unit":"","value":0.9}],"desc":"stop confidence enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"Stop Confidence Enable, if enabled, stop will be triggered when the robot confidence is less than the threshold.","key":"stopConfidenceTigger","name":"stop confidence enable","type":"comboBoxBool","value":"off"}],"desc":"Reflector Localization Setting, Reflector Localization provides an additional method of localization in situations where localization is easily lost, Requires laser and scene support","key":"reflector","name":"Reflector Localization","type":"array"},{"children":[{"bindType":"device:Laser","defaultValue":"","desc":"The device use for 3D localization, Only 3D laser is supported","key":"localizationLaser","name":"Localization Laser","type":"bindType","unit":"","value":""},{"children":[{"children":[{"defaultValue":true,"desc":"Relocalization with 3D feature","key":"relocWithFeature","name":"3D Feature Relocalization","type":"bool","value":true}],"desc":"3D Feature Localization, 3D feature positioning can be more stable than ordinary 3D positioning, but it requires the establishment of 3D feature maps.","key":"locWithFeature3d","name":"3D Feature Localization","type":"array"},{"children":[{"defaultValue":true,"desc":"Relocalization with 3D feature","key":"relocWithFeature","name":"3D Feature Relocalization","type":"bool","value":true}],"desc":"3D KF Localization, 3D Kalman point cloud filtering and positioning","key":"locWithKF3d","name":"3D KF Localization","type":"string"},{"desc":"3D NDT Localization, 3D normal distributions transform positioning","key":"locWithNDT3d","name":"3D NDT Localization","type":"string"}],"defaultValue":"locWithFeature3d","desc":"3D Localization Type","key":"localizationType3d","name":"3D Localization Type","type":"comboBox","value":"locWithFeature3d"},{"decimals":3,"defaultValue":1,"desc":"3D Localization Weight in fusion positioning, too large may reduce the smoothness of the trajectory.","key":"localizationWeight3d","maxValue":1,"minValue":0,"name":"3D Localization Weight","type":"double","unit":"","value":1},{"decimals":3,"defaultValue":0.3,"desc":"3D point cloud downsample size, the higher the number, the faster the calculation and the lower the accuracy.","key":"sourceDownSize3d","maxValue":1,"minValue":0.05,"name":"3D Source DownSize","type":"double","unit":"m","value":0.3},{"children":[{"desc":"stop confidence unable","key":"off","name":"OFF","type":"string"},{"children":[{"decimals":3,"defaultValue":0.2,"desc":"The threshold at which the error is reported if robot confidence is less than this value","key":"stopConfidenceThd","maxValue":1,"minValue":0,"name":"Stop Confidence Threshold","type":"double","unit":"","value":0.2}],"desc":"stop confidence enable","key":"on","name":"ON","type":"array"}],"defaultValue":"off","desc":"Stop Confidence Enable, if enabled, stop will be triggered when the robot confidence is less than the threshold.","key":"stopConfidenceTigger","name":"stop confidence enable","type":"comboBoxBool","value":"off"}],"desc":"3D Localization Setting, Requires 3D laser configured","key":"laser3d","name":"3D Laser Localization","type":"array"},{"children":[{"bindType":"device:Camera;device:CodeScanner","defaultValue":"","desc":"The device use for QR code localization, Supported QR scaner and some cameras are allowed","key":"localizationCodeScanner","name":"Localization QR Device","type":"bindType","unit":"","value":""},{"decimals":3,"defaultValue":2.0,"desc":"The Distance at Which the Error is Reported If Robot Can't See the QR Code","key":"noTagErrorDistance","maxValue":10.0,"minValue":0.0,"name":"No Tag Error Distance","type":"double","unit":"m","value":2.0},{"decimals":3,"defaultValue":1.5,"desc":"The Distance at Which the Robot Slow Down If Robot Can't See the QR Code","key":"noTagSlowDownDistance","maxValue":10.0,"minValue":0.0,"name":"No Tag Slow Down Distance","type":"double","unit":"m","value":1.5}],"desc":"QR Code Localization Setting","key":"codeScanner","name":"QR Code Localization","type":"array"}],"defaultValue":"laser2d","desc":"The localization type of this device","key":"localizationType","name":"Localization Type","type":"comboBox","value":"laser2d"},{"children":[{"bindType":"map:mark","defaultValue":"","desc":"Start up init location","isClone":true,"key":"initLocation","name":"Init Location","type":"bindType","value":""}],"desc":"Startup reloc","key":"startupReloc","name":"Startup Reloc","type":"array"},{"children":[{"defaultValue":20,"desc":"laser distance","key":"laserDistance","maxValue":200,"minValue":1,"name":"Laser distance","type":"double","unit":"m","value":20},{"defaultValue":50,"desc":"Localization Map Distance","key":"locMapDistance","maxValue":300,"minValue":5,"name":"Localization Map Distance","type":"double","unit":"m","value":50}],"desc":"Block map loading range configuration","key":"blockMap","name":"Block Map","type":"array"}]}