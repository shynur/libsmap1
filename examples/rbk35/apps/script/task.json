{
  "desc": "Script Configuration Parameters",
  "groups": [
    {
      "key": "script",
      "name": "Script Settings",
      "desc": "脚本相关配置",
      "type": "array",
      "required": false,
      "children": [
        {
          "key": "timeout",
          "name": "Timeout",
          "desc": "脚本超时时间",
          "type": "float",
          "unit": "s",
          "required": false,
          "defaultValue": 120
        },
        {
          "key": "scriptDebug",
          "name": "Script Debug",
          "desc": "是否打印调试信息",
          "type": "bool",
          "required": false,
          "defaultValue": false
        }
      ]
    },
    {
      "key": "fork",
      "name": "Fork Settings",
      "desc": "货叉相关配置",
      "type": "array",
      "required": false,
      "children": [
        {
          "key": "loadAndUnloadCheck",
          "name": "Load And Unload Check",
          "desc": "取放货是否根据载货状态报错",
          "type": "bool",
          "required": false,
          "defaultValue": false
        },
        {
          "key": "upMaxSpeedWithGoods",
          "name": "Up Max Speed With Goods",
          "desc": "载货时的货叉上升最大速度",
          "type": "float",
          "unit": "m/s",
          "required": false,
          "defaultValue": 0.06,
          "minValue": 0,
          "maxValue": 0.5
        },
        {
          "key": "downMaxSpeedWithGoods",
          "name": "Down Max Speed With Goods",
          "desc": "载货时的货叉下降最大速度",
          "type": "float",
          "unit": "m/s",
          "required": false,
          "defaultValue": 0.06,
          "minValue": 0,
          "maxValue": 0.5
