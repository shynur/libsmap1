              "type": "float",
              "unit": "m",
              "required": false,
              "defaultValue": 0.8,
              "minValue": 0,
              "maxValue": 2
            },
            {
              "key": "minAheadDist",
              "name": "Min Ahead Dist",
              "desc": "识别取货的最小直线距离",
              "type": "float",
              "unit": "m",
              "required": false,
              "defaultValue": 0.662,
              "minValue": -2,
              "maxValue": 2
            },
            {
              "key": "zMax",
              "name": "sort the rec results by height",
              "desc": "根据识别结果的高度由大到小进行排序",
              "type": "bool",
              "required": false,
              "defaultValue": true
            }
          ]
        },
        {
          "key": "noRecLoad",
          "name": "Load By Landmark",
          "desc": "根据站点位置取货",
          "type": "array",
          "required": false,
          "children": [
            {
              "key": "forkDiDist",
              "name": "Fork DI Dist",
              "desc": "盲插到位后后退距离",
              "type": "float",
              "unit": "m",
              "required": false,
              "defaultValue": 0,
              "minValue": -2,
              "maxValue": 2
            },
            {
              "key": "enableContactDiNoRec",
              "name": "Enable Contact DI (No Rec)",
              "desc": "盲叉取货是否启用到位di",
              "type": "bool",
              "required": false,
              "defaultValue": true
            },
            {
              "key": "goodsWidth",
              "name": "Goods Width",
              "desc": "盲插取货时的货物宽度",
              "type": "float",
              "required": false,
              "defaultValue": 1.0
            },
            {
              "key": "goodsLength",
              "name": "Goods Length",
              "desc": "盲插取货时的货物长度",
              "type": "float",
              "required": false,
              "defaultValue": 1.2
            }
          ]
        }
      ]
    },
    {
      "key": "linearUnload",
      "name": "Linear Unload",
      "desc": "线性堆栈相关配置",
      "type": "array",
      "required": false,
      "children": [
        {
          "key": "laserWidth",
          "name": "Laser Width",
          "desc": "线性堆栈激光宽度",
          "type": "float",
          "unit": "m",
          "required": false,
          "defaultValue": 0.1,
          "minValue": 0,
          "maxValue": 1
        },
        {
          "key": "obsDist",
          "name": "Obs Dist",
          "desc": "线性堆栈的避障距离",
          "type": "float",
          "unit": "m",
          "required": false,
          "defaultValue": 0.5,
          "minValue": 0,
          "maxValue": 1
        },
        {
          "key": "loadObsDist",
          "name": "Load Obs Dist",
          "desc": "取货进叉时的避障距离",
          "type": "float",
          "unit": "m",
          "required": false,
          "defaultValue": 0.1,
          "minValue": 0,
          "maxValue": 11
        }
      ]
    }
