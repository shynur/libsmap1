        {
          "key": "backLaserEnableHeight",
          "name": "Back Laser Enable Height",
          "desc": "后置激光避障生效时的货叉高度",
          "type": "float",
          "unit": "m",
          "required": false,
          "defaultValue": 0.3,
          "minValue": 0,
          "maxValue": 2
        },
        {
          "key": "checkGoodsWhileLoad",
          "name": "Check Goods While Load",
          "desc": "载货时检测到位 di",
          "type": "bool",
          "required": false,
          "defaultValue": true
        },
        {
          "key": "checkAllContactDi",
          "name": "Check All Contact DI",
          "desc": "检测所有到位di",
          "type": "bool",
          "required": false,
          "defaultValue": false
        }
      ]
    },
    {
      "key": "loadUnload",
      "name": "Load & Unload",
      "desc": "取放货相关配置",
