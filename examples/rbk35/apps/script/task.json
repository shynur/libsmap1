      "required": false,
      "children": [
        {
          "key": "useStraightLine",
          "name": "Use Straight Line",
          "desc": "调整是否走直线曲线",
          "type": "bool",
          "required": false,
          "defaultValue": false
        },
        {
          "key": "bezierReturn",
          "name": "Bezier Return",
          "desc": "取放货后是否按原路返回",
          "type": "bool",
          "required": false,
          "defaultValue": true
        },
        {
          "key": "toLoadObsStopDist",
          "name": "Load Obstacle Stop Distance",
          "desc": "取货时后退的避障距离",
          "type": "float",
          "unit": "m",
          "required": false,
          "defaultValue": 0.05,
          "minValue": 0,
          "maxValue": 2
        },
        {
          "key": "checkAllContactDi",
          "name": "Check All Contact DI",
          "desc": "需要先启用 di 检测，检测所有到位di",
          "type": "bool",
          "required": false,
          "defaultValue": false
