{"desc":"Power.","groups":[{"children":[{"bindType":"device:DO multiple","defaultValue":"","desc":"Name of charging DO.","key":"switchDO","name":"Charging Circuit Control DO","type":"bindType","unit":"","value":""},{"bindType":"device:DI multiple","defaultValue":"","desc":"When this DI is triggered, it indicates that the battery has started charging.","key":"chargeDI","name":"Charging Status Trigger DI","type":"bindType","unit":"","value":""},{"bindType":"device:DO multiple","defaultValue":"","desc":"Power off DO.","key":"powerOffDO","name":"Turn Off DO During Automatic Charging","type":"bindType","unit":"","value":""},{"defaultValue":1.0,"desc":"Fix the path to charge, if the distance is less than this distance, open the charging DO.","key":"openDODist","maxValue":100.0,"minValue":-1.0,"name":"Charging Circuit Activation Distance","type":"double","unit":"m","value":1.0},{"defaultValue":0.02,"desc":"Charge running speed.","key":"chargePathSpeed","maxValue":1.5,"minValue":0.001,"name":"Charge Path Speed","type":"double","unit":"m/s","value":0.02},{"defaultValue":-1.0,"desc":"After detecting the input current of the battery, move forward for a certain amount of time and then stop moving for charging. The forward speed used is chargePathSpeed.","key":"delayArriveTime","maxValue":60.0,"minValue":-1.0,"name":"Additional Movement Time After Reaching Target","type":"double","unit":"s","value":-1.0},{"children":[{"children":[{"defaultValue":0.2,"desc":"The minimum straight-line distance a robot needs to maintain before charging.","key":"recAheadDist","maxValue":10.0,"minValue":-1.0,"name":"End Straight Line Distance","type":"double","unit":"m","value":0.2},{"defaultValue":false,"desc":"Use mileage mode when charging.","key":"chargeUseOdo","name":"Charge Use Odometer","type":"bool","unit":"","value":false},{"defaultValue":true,"desc":"Target point uses station direction.","key":"targetPointUseStationDir","name":"Target Point Uses Station Direction","type":"bool","unit":"","value":true}],"desc":"Curve adjustment methods.","key":"curve","name":"Curve","type":"array"},{"children":[{"defaultValue":0.5,"desc":"Automatic charging lead distance.","key":"recAheadDist","maxValue":10.0,"minValue":-1.0,"name":"Recognition Charge Ahead Distance","type":"double","unit":"m","value":0.5},{"defaultValue":false,"desc":"Use mileage mode when charging.","key":"chargeUseOdo","name":"Charge Use Odometer","type":"bool","unit":"","value":false},{"defaultValue":true,"desc":"Target point uses station direction.","key":"targetPointUseStationDir","name":"Target Point Uses Station Direction","type":"bool","unit":"","value":true}],"desc":"Straight line adjustment methods.","key":"straightLine","name":"Straight Line","type":"array"}],"defaultValue":"curve","desc":"Identify adjustment methods.","key":"identifyAdjustmentMethods","name":"Identify Adjustment Methods","type":"comboBox","value":"curve"},{"defaultValue":1.0,"desc":"Motor disable time after charging.","key":"chargeDisableMotorTime","maxValue":100.0,"minValue":0.0,"name":"Motor Disable Time After Charging","type":"double","unit":"s","value":1.0},{"defaultValue":120.0,"desc":"Maximum time for the charger to power on, and start timing when it reaches the charging position.","key":"waitChargeTimeoutDur","maxValue":100000.0,"minValue":-1.0,"name":"Waiting For Charging Timeout Duration","type":"double","unit":"s","value":120.0},{"defaultValue":200.0,"desc":"Maximum time for automatic charging, timing when the task starts.","key":"chargeTaskTimeoutDur","maxValue":100000.0,"minValue":1.0,"name":"Charging Task Timeout Duration","type":"double","unit":"s","value":200.0},{"defaultValue":0.3,"desc":"The distance the robot should move away from charger when charge leaving.","key":"leavingDist","maxValue":1.0,"minValue":0.1,"name":"Charge Leaving Distance","type":"double","unit":"m","value":0.3},{"defaultValue":false,"desc":"Whether to turn off charging DO during emergency stop.","key":"disableByEMC","name":"Turn Off Charging When EMC","type":"bool","unit":"","value":false},{"defaultValue":100,"desc":"Battery full percentage","key":"fullPercentage","maxValue":100,"minValue":1,"name":"Charging Upper Limit","type":"int32","unit":"%","value":100},{"defaultValue":7,"desc":"Every set days need to full charge for this battery","key":"fullChargePeriod","maxValue":60,"minValue":1,"name":"Full Charge Period","type":"uint32","unit":"day","value":7},{"children":[{"desc":"Protocol charging","key":"protocolCharging","name":"Protocol Charging","type":"string"},{"children":[{"defaultValue":80,"desc":"Switching threshold for large and small currents","key":"handoffBatteryLevel","maxValue":100,"minValue":0,"name":"Switching Threshold For Large And Small Currents","type":"int32","unit":"%","value":0},{"defaultValue":0.5,"desc":"Big current","key":"bigCurrent","maxValue":1.0,"minValue":0.0,"name":"Big Current","type":"double","unit":"C","value":0.5},{"defaultValue":0.25,"desc":"Small current","key":"smallCurrent","maxValue":1.0,"minValue":0.0,"name":"Small Current","type":"double","unit":"C","value":0.25}],"desc":"Non-protocol","key":"stateCharging","name":"Non-protocol","type":"array"}],"defaultValue":"protocolCharging","desc":"Charging mode","key":"chargingMode","name":"Charging Mode","type":"comboBox","value":"protocolCharging"}],"desc":"Charge.","key":"charge","name":"Charge","type":"array"},{"children":[{"children":[{"desc":"Disable Automatic Shutdown On Low Battery","key":"off","name":"Disable Automatic Shutdown On Low Battery","type":"array"},{"children":[{"defaultValue":10,"desc":"Shutdown percentage","key":"shutdownPercentage","maxValue":100,"minValue":-1,"name":"Shutdown Battery Threshold","type":"int32","unit":"%","value":10},{"defaultValue":120,"desc":"The value of the time maintained after shutdown","key":"shutdownStillTime","maxValue":99999,"minValue":60,"name":"Shutdown Survial Time","type":"int32","unit":"s","value":120}],"desc":"Enable Automatic Shutdown On Low Battery","key":"on","name":"Enable Automatic Shutdown On Low Battery","type":"array"}],"defaultValue":"off","desc":"Enable automatic shutdown on low battery","key":"automaticShutdown","name":"Enable Automatic Shutdown On Low Battery","type":"comboBoxBool","value":"off"},{"defaultValue":-1,"desc":"Error percentage","key":"errorPercentage","maxValue":100,"minValue":-1,"name":"Error Percentage","type":"int32","unit":"%","value":-1}],"desc":"Basic battery parameters","key":"lowBatteryManage","name":"Low Battery Manage","type":"array"}]}